{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All",
      "dependsOrder": "sequence",
      "dependsOn": ["Build API", "Build Frontend"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build API",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app/api"
      },
      "windows": {
        "command": "npm.cmd"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app/frontend"
      },
      "windows": {
        "command": "npm.cmd"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$tsc"
      ]
    }
  ]
}
